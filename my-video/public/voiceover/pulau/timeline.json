 "scenes": [
  {
   "id": "01-a",
   "text": "Indonesia punya lebih dari 17.000 pulau.",
   "start": 0.0,
   "end": 3.09
  },
  {
   "id": "02-b",
   "text": "Kalau kita mampir ke satu pulau tiap hari, butuh lebih dari 46 tahun buat ngelilingin semuanya.",
   "start": 3.09,
   "end": 9.506
  },
  {
   "id": "03-c",
   "text": "Artinya, seumur hidup, kebanyakan dari kita cuma kenal segelintir aja.",
   "start": 9.506,
   "end": 14.49
  },
  {
   "id": "04-tanya",
   "text": "Tapi gimana kalau semua pulau itu nyatu, jadi satu daratan raksasa?",
   "start": 14.49,
   "end": 19.298
  },
  {
   "id": "05-close",
   "text": "Kita jadi lebih maju? Mudik jadi lebih gampang? Atau justru kita kehilangan hal yang bikin Indonesia jadi Indonesia?",
   "start": 19.298,
   "end": 27.089
  }
 ],
