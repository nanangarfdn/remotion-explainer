 "scenes": [
  {
   "id": "01-a",
   "text": "Bangun pagi, dengerin ayam berkokok, udara segar, tetangga nyapa dari teras.",
   "start": 0.0,
   "end": 6.293
  },
  {
   "id": "02-b",
   "text": "Atau bangun pagi, dengerin klakson, kejar kereta, tapi semua yang kamu mau tinggal pesan.",
   "start": 6.293,
   "end": 13.731
  },
  {
   "id": "03-c",
   "text": "Dua-duanya kedengeran enak, dua-duanya juga punya harga.",
   "start": 13.731,
   "end": 17.777
  },
  {
   "id": "04-tanya",
   "text": "Tapi kalau harus milih satu buat seumur hidup, mending mana: hidup di kota, atau di desa?",
   "start": 17.777,
   "end": 23.839
  },
  {
   "id": "05-close",
   "text": "Dan apa kata ilmu pengetahuan soal mana yang bikin kita lebih bahagia?",
   "start": 23.839,
   "end": 28.761
  }
 ],
