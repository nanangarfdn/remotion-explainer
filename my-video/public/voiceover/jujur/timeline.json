 "scenes": [
  {
   "id": "j1-hook",
   "text": "Gimana kalau mulai besok, semua orang di dunia nggak bisa bohong?",
   "start": 0,
   "end": 4.577
  },
  {
   "id": "j2-rambut",
   "text": "Kamu potong rambut, temanmu langsung bilang: \"Mending yang kemarin.\" Dan kamu jawab: \"Iya, mukamu juga.\"",
   "start": 4.577,
   "end": 12.577
  },
  {
   "id": "j3-kamus",
   "text": "Bahasa kita berubah total. \"Mampir dulu!\" artinya, tolong jangan mampir. \"Bagus kok,\" jelek. \"Nanti aku kabarin,\" nggak akan. Dan \"otewe\"... baru bangun.",
   "start": 12.577,
   "end": 27.316
  },
  {
   "id": "j4-selfie",
   "text": "Ada yang kirim foto selfie, nanya, \"gimana?\" Jawabannya keluar, sebelum kamu sempat mikir.",
   "start": 27.316,
   "end": 34.688
  },
  {
   "id": "j5-kantor",
   "text": "Di kantor, \"meeting ini penting\" berubah jadi, \"harusnya cukup lewat email.\"",
   "start": 34.688,
   "end": 41.016
  },
  {
   "id": "j6-twist",
   "text": "Tapi tanpa bohong kecil, nggak ada lagi kejutan ulang tahun. Nggak ada \"kamu pasti bisa\", waktu kamu sendiri ragu.",
   "start": 41.016,
   "end": 50.373
  },
  {
   "id": "j7-cta",
   "text": "Dan ada satu profesi yang bakal hilang paling duluan. Tebak apa? Tulis di komentar. Jujur ya.",
   "start": 50.373,
   "end": 57.981
  }
 ],
