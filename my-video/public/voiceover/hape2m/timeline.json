{
 "id": "hape2m",
 "fps": 30,
 "duration": 110.733061,
 "audio": "voiceover/hape2m/full.mp3",
 "scenes": [
  {
   "id": "h1-ingat",
   "text": "Coba ingat, kapan terakhir kali kamu megang hape?",
   "start": 0.0,
   "end": 3.254
  },
  {
   "id": "h2-kamu",
   "text": "5 menit lalu? Atau, jangan-jangan, kamu lagi megang hape sekarang.",
   "start": 3.254,
   "end": 8.801
  },
  {
   "id": "h3-layar",
   "text": "Rata-rata, kita bisa ngabisin berjam-jam sehari cuma buat natap layar sekecil ini.",
   "start": 8.801,
   "end": 14.811
  },
  {
   "id": "h4-hilang",
   "text": "Tapi gimana kalau mulai besok, hape kamu hilang selama 30 hari?",
   "start": 14.811,
   "end": 19.521
  },
  {
   "id": "h5-tanya",
   "text": "Apa yang bakal terjadi sama otak kita? Dan berapa lama sampai kita mulai panik?",
   "start": 19.521,
   "end": 24.462
  },
  {
   "id": "b1-panik",
   "text": "Oke, kita jawab yang paling cepat dulu: panik. Ternyata nggak perlu nunggu 30 hari.",
   "start": 24.462,
   "end": 30.479
  },
  {
   "id": "b2-kelas",
   "text": "Di satu penelitian, mahasiswa yang hapenya disimpan mulai cemas cuma 10 menit kemudian. Terutama yang paling sering main hape. Dan makin lama, cemasnya makin naik.",
   "start": 30.479,
   "end": 41.463
  },
  {
   "id": "b3-enam",
   "text": "Wajar sih. Orang Indonesia rata-rata main hape sekitar 6 jam sehari, paling lama di dunia. Itu lebih dari sepertiga waktu kita melek.",
   "start": 41.463,
   "end": 50.595
  },
  {
   "id": "b4-otak",
   "text": "Terus, gimana dengan otaknya? 30 hari memang belum ada yang neliti. Tapi 2 minggu, udah.",
   "start": 50.595,
   "end": 56.755
  },
  {
   "id": "b5-studi",
   "text": "Peneliti minta 467 orang mematikan internet di hape mereka selama 2 minggu. Telepon dan pesan singkat masih boleh.",
   "start": 56.755,
   "end": 65.085
  },
  {
   "id": "b6-hasil",
   "text": "Hasilnya, 9 dari 10 orang membaik di salah satunya: suasana hati, kesehatan mental, atau fokus.",
   "start": 65.085,
   "end": 72.604
  },
  {
   "id": "b7-fokus",
   "text": "Bahkan, naiknya fokus mereka setara mundur 10 tahun dari penurunan karena umur.",
   "start": 72.604,
   "end": 78.183
  },
  {
   "id": "b8-luar",
   "text": "Uniknya, ini bukan sulap. Tanpa internet, mereka jadi lebih sering ketemu orang, olahraga, dan jalan di luar.",
   "start": 78.183,
   "end": 85.516
  },
  {
   "id": "b9-awet",
   "text": "Efeknya juga masih kerasa 2 minggu setelah internetnya nyala lagi.",
   "start": 85.516,
   "end": 89.682
  },
  {
   "id": "b10-susah",
   "text": "Tapi jujur aja, ini nggak gampang. Cuma seperempat peserta yang kuat sampai 2 minggu penuh.",
   "start": 89.682,
   "end": 95.696
  },
  {
   "id": "b11-jadi",
   "text": "Jadi, ya, otak kita bakal panik di awal, tapi besar kemungkinan malah jadi lebih tenang dan lebih fokus.",
   "start": 95.696,
   "end": 103.118
  },
  {
   "id": "b12-saran",
   "text": "Nggak perlu buang hape kok. Coba aja matiin data seharian pas akhir pekan.",
   "start": 103.118,
   "end": 107.436
  },
  {
   "id": "b13-close",
   "text": "Kamu kira-kira kuat berapa lama? Tulis di komentar.",
   "start": 107.436,
   "end": 110.733
  }
 ],
