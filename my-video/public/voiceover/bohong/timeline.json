 "scenes": [
  {
   "id": "01-a",
   "text": "\"Bentar lagi sampai.\" Padahal baru mandi.",
   "start": 0.0,
   "end": 3.364
  },
  {
   "id": "02-b",
   "text": "\"Enak kok masakannya.\" Padahal keasinan.",
   "start": 3.364,
   "end": 6.793
  },
  {
   "id": "03-c",
   "text": "Kita semua pernah bohong kecil kayak gini, bahkan mungkin hari ini.",
   "start": 6.793,
   "end": 11.232
  },
  {
   "id": "04-tanya",
   "text": "Tapi gimana kalau mulai sekarang, kita sama sekali gak bisa bohong?",
   "start": 11.232,
   "end": 15.885
  },
  {
   "id": "05-close",
   "text": "Apakah hidup jadi lebih damai? Atau justru semua pertemanan kita bakal hancur dalam seminggu?",
   "start": 15.885,
   "end": 21.969
  }
 ],
